# ---- TTS provider ----
# openai  = OpenAI API voices (paid, needs OPENAI_API_KEY)
# windows = built-in Windows speech voices (free, offline, no API key)
TTS_PROVIDER=openai

# ---- Windows local TTS (TTS_PROVIDER=windows) ----
# Empty = choose an installed English voice automatically (en-GB first, then en-US).
# Exact or partial name, e.g. Hazel, Zira, David, "Microsoft Zira Desktop"
WINDOWS_TTS_VOICE=
# -10 (slowest) .. 10 (fastest); 0 = normal
WINDOWS_TTS_RATE=0
# 0 .. 100
WINDOWS_TTS_VOLUME=100

# ---- OpenAI TTS (TTS_PROVIDER=openai; used only by `npm run build-course`) ----
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Optional: speaking style (gpt-4o-mini-tts only)
TTS_INSTRUCTIONS=Speak in a calm, clear, professional tone suitable for a medical education course.
# Optional: 0.25 - 4.0 (1.0 = normal)
TTS_SPEED=1.0
# Parallel TTS jobs (both providers)
TTS_CONCURRENCY=3
# Set to false to send narration to TTS exactly as written
TTS_NORMALIZE_MEDICAL=true

# ---- Folders ----
INPUT_DIR=./input
OUTPUT_DIR=./output
TEMP_DIR=./temp

# ---- Video ----
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
# Silence added before/after each slide's narration (seconds)
SLIDE_LEAD_IN_SECONDS=0.3
SLIDE_TAIL_SECONDS=0.7
# Letterbox colour if a slide is not 16:9
SLIDE_PAD_COLOR=#000000
# Parallel FFmpeg segment encodes
SEGMENT_CONCURRENCY=2

# ---- Optional overrides ----
# COURSE_TITLE=Risk Factors for Diabetes
# COURSE_SLUG=risk-factors-for-diabetes

# ---- Optional tool paths (Windows or Git Bash style both work) ----
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# PDFTOPPM_PATH=C:\poppler\Library\bin\pdftoppm.exe

# ---- Web dashboard (npm run dashboard) ----
# DASHBOARD_PORT=8787
# Extra web origins allowed to use the local engine (comma-separated), e.g. a custom domain
# DASHBOARD_ALLOWED_ORIGINS=https://studio.example.com

# ---- Publishing to the website library (npm run publish-course) ----
# Option A (OIDC): `vercel env pull .env.local` provides VERCEL_OIDC_TOKEN (expires ~12h); add the store id here.
# BLOB_STORE_ID=store_...
# Option B: read-write token of a PUBLIC Vercel Blob store. Never commit the real value.
# BLOB_READ_WRITE_TOKEN=
# Only if the publish command tells you the catalog lives at a different address:
# LIBRARY_CATALOG_URL=
